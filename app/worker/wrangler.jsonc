{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "finance",
  "main": "src/index.ts",
  "compatibility_date": "2025-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    { "pattern": "api.finance.fausto.ar", "custom_domain": true }
  ],
  "r2_buckets": [
    {
      "binding": "DOCS",
      "bucket_name": "finance-docs"
    }
  ],
  // Workers AI: the second reader for a captured message (GLM), run beside
  // Gemini from the test bench so the two can be compared on real alerts.
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "auth",
      "database_id": "b6532fe4-d2a1-42b2-b783-00d97405614b"
    }
  ],
  "vars": {
    "TURSO_ORG": "faustofusse",
    "APP_SLUG": "finance",
    "FORWARD_TO": "faustofusse@gmail.com",
    "ACCOUNT_ID": "f12da7851e4dd1d107a80417a1d4cbbd",
    "AI_GATEWAY": "finance",
    "GEMINI_MODELS": "gemini-3.5-flash,gemini-3.6-flash,gemini-3.5-flash-lite",
    // wa-bridge (app/wa-bridge): the WhatsApp socket cannot live on Workers.
    // BRIDGE_SECRET is a secret (wrangler secret put BRIDGE_SECRET).
    "BRIDGE_URL": "https://weil-wa-bridge.fly.dev",
    "WHATSAPP_NUMBER": "5491178265131"
  }
}
