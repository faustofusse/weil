{
  "name": "finance-worker",
  "private": true,
  "scripts": {
    "deploy": "WRANGLER_DOCKER_BIN=false cf deploy",
    "dev": "WRANGLER_DOCKER_BIN=false cf dev",
    "typecheck": "WRANGLER_DOCKER_BIN=false cf workers types && tsc --noEmit",
    "tail": "wrangler tail finance",
    "secret": "wrangler secret put --name finance"
  },
  "devDependencies": {
    "cf": "^1.0.0-beta.12",
    "typescript": "^5.9.2",
    "wrangler": "^4.147.0"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "postal-mime": "^3.0.0"
  },
  "type": "module"
}
