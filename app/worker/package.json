{
  "name": "finance-worker",
  "private": true,
  "scripts": {
    "deploy": "WRANGLER_DOCKER_BIN=false cf deploy",
    "dev": "WRANGLER_DOCKER_BIN=false cf dev",
    "typecheck": "WRANGLER_DOCKER_BIN=false cf workers types && tsc --noEmit",
    "tail": "npx -y wrangler@4 tail finance --format pretty",
    "secret": "npx -y wrangler@4 secret put --name finance"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-52b0dc0e9",
    "cf": "1.0.0-beta.12",
    "typescript": "^5.9.2",
    "vite": "^8.3.3"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "postal-mime": "^3.0.0"
  },
  "type": "module"
}
