{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "finance-dry",
	"compatibility_date": "2025-12-01",
	"compatibility_flags": ["nodejs_compat"],
	"main": "build/server/index.js",
	"assets": {
		"directory": "build/client",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application"
	},
	// A subdomain of finance.fausto.ar so the existing passkeys (rp_id
	// finance.fausto.ar) work here; the origin is allowlisted in the auth
	// worker's APPS var.
	"routes": [{ "pattern": "dry.finance.fausto.ar", "custom_domain": true }],
	// Only what a *dry* run needs: the shared auth D1 to verify the session
	// cookie, and the model (GEMINI_API_KEY, a secret). Deliberately no R2
	// binding and no write path — this worker structurally cannot store a
	// document or touch the ledger — and no Turso API token either: the user's
	// own database token rides in on the request (x-turso-token).
	"d1_databases": [
		{
			"binding": "AUTH_DB",
			"database_name": "auth",
			"database_id": "b6532fe4-d2a1-42b2-b783-00d97405614b"
		}
	],
	"vars": {
		"APP_SLUG": "finance",
		"ACCOUNT_ID": "f12da7851e4dd1d107a80417a1d4cbbd",
		"AI_GATEWAY": "finance",
		"GEMINI_MODELS": "gemini-3.5-flash,gemini-3.6-flash,gemini-3.5-flash-lite"
	}
}
