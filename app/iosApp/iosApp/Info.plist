<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- The app ships one light palette (Menta). Without this, a phone in
	     dark mode gets a white status bar clock over our near-white page. -->
	<key>UIUserInterfaceStyle</key>
	<string>Light</string>
	<key>NSCameraUsageDescription</key>
	<string>Scan the pairing QR code shown on your other device, or a merchant QR to pay it.</string>
	<!-- canOpenURL answers false for any scheme not listed here, with no
	     error, so the QR handoff would report "no wallet installed" on a
	     phone that has Mercado Pago. See IosWalletLauncher. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>mercadopago</string>
		<string>meli</string>
	</array>
</dict>
</plist>
