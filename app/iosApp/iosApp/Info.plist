<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- The app ships one light palette (Menta). Without this, a phone in
	     dark mode gets a white status bar clock over our near-white page. -->
	<key>UIUserInterfaceStyle</key>
	<string>Light</string>
	<key>NSCameraUsageDescription</key>
	<string>Scan the pairing QR code shown on your other device, or a merchant QR to pay it.</string>
	<!-- canOpenURL answers false for any scheme not listed here, with no
	     error, so the QR handoff would report "no wallet installed" on a
	     phone that has Mercado Pago. See IosWalletLauncher. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>mercadopago</string>
		<string>meli</string>
	</array>
	<!-- weil://import is how the Share Extension wakes the app after
	     parking a document in the App Group (SharedImportHandoff). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>ar.fausto.finance</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>weil</string>
			</array>
		</dict>
	</array>
	<!-- "Open in Weil" / AirDrop for the same types the importer takes. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Importable document</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.adobe.pdf</string>
				<string>public.jpeg</string>
				<string>public.png</string>
				<string>org.webmproject.webp</string>
				<string>public.heic</string>
				<string>public.heif</string>
				<string>public.comma-separated-values-text</string>
			</array>
		</dict>
	</array>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
</dict>
</plist>
